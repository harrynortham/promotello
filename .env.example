# Copy to .env.local and fill in. See README.md for what each one is for.
#
# Everything the app reads is here, bar three set for you and never by
# hand: NODE_ENV (Next.js), CI, and NEXT_PUBLIC_VERCEL_ENV (Vercel).
#
# Working locally, the first three come from `npm run db:env` and point at
# the database on your machine. docs/ENVIRONMENTS.md explains which copy
# you are touching and why it matters.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=

# Leave empty in development: nothing is emailed without them.
RESEND_API_KEY=
EMAIL_FROM="Promotello <offers@mail.promotello.com>"
EMAIL_REPLY_TO=support@promotello.com
# Contact form messages (default support@promotello.com).
CONTACT_EMAIL=

CRON_SECRET=

# "Continue with" buttons, once set up in Supabase (docs/SOCIAL_LOGIN.md).
NEXT_PUBLIC_AUTH_PROVIDERS=

# Optional: a different Sentry project. Error reports are on for Vercel
# deployments and off locally (lib/sentry.ts).
NEXT_PUBLIC_SENTRY_DSN=

# The page editor (lib/keystatic-enabled.ts). Left empty it runs against
# local files, which is what you want while developing. Set storage to
# "github" with the app's slug to edit through GitHub instead.
NEXT_PUBLIC_KEYSTATIC_STORAGE=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------

# Where Playwright points (playwright.config.ts). Defaults to
# http://localhost:3000, so it is only needed to test somewhere else.
PLAYWRIGHT_BASE_URL=

# Set to 1 to include tests/e2e/real-email-sign-in.spec.ts, which sends a
# genuine email and so also needs RESEND_API_KEY. Skipped without both.
E2E_REAL_EMAIL=

# ---------------------------------------------------------------------------
# .env.production.local, not this file
# ---------------------------------------------------------------------------
#
# PROD_DB_URL is the live database's connection string, read by
# `npm run db:ship` (scripts/ship-to-prod.mjs). It belongs in
# .env.production.local, which is gitignored, and never in .env.local —
# keeping it out of the file the app loads is the point. Dashboard →
# Settings → Database → Connection string → URI. The password inside it
# has to be percent-encoded.
#
#   PROD_DB_URL=postgresql://postgres:...@db.<ref>.supabase.co:5432/postgres
